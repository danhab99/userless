# Userless P2P Application Configuration

# Lobby server URL (WebSocket endpoint for peer discovery)
# Default: ws://localhost:4445/lobby (or wss:// for HTTPS)
VITE_USERLESS_URL=localhost:4445

# TURN Server Configuration (optional, for NAT traversal)
# If not set, app falls back to STUN server only (may fail behind restrictive NAT)
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=optional_username
# VITE_TURN_PASSWORD=optional_password

# Example TURN configurations:
# Open TURN server (demo):
#   VITE_TURN_URL=turn:demo.coturn.net:3478
# 
# Private TURN server:
#   VITE_TURN_URL=turn:internal.example.com:3478
#   VITE_TURN_USERNAME=user123
#   VITE_TURN_PASSWORD=secure_password
