datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "go run github.com/steebchen/prisma-client-go"
  binaryTargets = "native"
}

model Thread {
  body         String
  hash         String        @unique
  id           String        @id @default(uuid()) @map("_id")
  parent       Thread?       @relation(name: "ParentThread", fields: [replyTo], references: [hash], onDelete: NoAction, onUpdate: NoAction)
  replies      Thread[]      @relation(name: "ParentThread")
  replyTo      String?
  signedBy     PublicKey     @relation(fields: [signedById], references: [keyId], onDelete: NoAction, onUpdate: NoAction)
  signedById   String
  timestamp    DateTime
  info         Json?
  threadPolicy ThreadPolicy?

  @@index([replyTo])
  @@index([signedById])
}

model ThreadPolicy {
  id             String   @id @default(uuid()) @map("_id")
  visible        Boolean  @default(true)
  acceptsReplies Boolean  @default(true)
  encryptFor     String[]
  policyEditors  String[]
  advertise      Boolean  @default(false)
  thread         Thread?  @relation(fields: [threadHash], references: [hash])
  threadHash     String?  @unique
}

model PublicKey {
  armoredKey        String          @unique
  comment           String
  email             String
  finger            String          @unique
  id                String          @id @default(uuid()) @map("_id")
  keyId             String          @unique
  name              String
  threads           Thread[]
  policy            PublicKeyPolicy @relation(fields: [publicKeyPolicyId], references: [id])
  files             File[]
  publicKeyPolicyId String

  @@index([email])
  @@index([name])
  @@index([keyId])
}

model PublicKeyPolicy {
  id                   String      @id @default(uuid()) @map("_id")
  revoked              Boolean     @default(false)
  allowedToPost        Boolean     @default(true)
  canStartThreads      Boolean     @default(true)
  isMaster             Boolean     @default(false)
  allowedToUploadFiles Boolean     @default(true)
  maxFileSize          BigInt      @default(1000000)
  PublicKey            PublicKey[]
}

model File {
  id         String    @id @default(uuid()) @map("_id")
  signedBy   PublicKey @relation(fields: [signedById], references: [finger])
  signedById String
  hash       String    @unique
  timestamp  DateTime
  size       BigInt
  mimeType   String?
}
